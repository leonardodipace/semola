{
  "name": "semola",
  "version": "0.6.9",
  "description": "Zero-dependency TypeScript toolkit for Bun. Typed REST APIs with OpenAPI, Redis queues, pub/sub, ORM, durable workflows, caching, auth policies, i18n, and more.",
  "homepage": "https://semo.la",
  "bugs": {
    "url": "https://github.com/leonardodipace/semola/issues"
  },
  "type": "module",
  "bin": {
    "semola": "./dist/cli/index.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/lib/errors/index.d.mts",
        "default": "./dist/lib/errors/index.mjs"
      },
      "require": {
        "types": "./dist/lib/errors/index.d.cts",
        "default": "./dist/lib/errors/index.cjs"
      }
    },
    "./cache": {
      "import": {
        "types": "./dist/lib/cache/index.d.mts",
        "default": "./dist/lib/cache/index.mjs"
      },
      "require": {
        "types": "./dist/lib/cache/index.d.cts",
        "default": "./dist/lib/cache/index.cjs"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/lib/otel/index.d.mts",
        "default": "./dist/lib/otel/index.mjs"
      },
      "require": {
        "types": "./dist/lib/otel/index.d.cts",
        "default": "./dist/lib/otel/index.cjs"
      }
    },
    "./i18n": {
      "import": {
        "types": "./dist/lib/i18n/index.d.mts",
        "default": "./dist/lib/i18n/index.mjs"
      },
      "require": {
        "types": "./dist/lib/i18n/index.d.cts",
        "default": "./dist/lib/i18n/index.cjs"
      }
    },
    "./policy": {
      "import": {
        "types": "./dist/lib/policy/index.d.mts",
        "default": "./dist/lib/policy/index.mjs"
      },
      "require": {
        "types": "./dist/lib/policy/index.d.cts",
        "default": "./dist/lib/policy/index.cjs"
      }
    },
    "./api": {
      "import": {
        "types": "./dist/lib/api/index.d.mts",
        "default": "./dist/lib/api/index.mjs"
      },
      "require": {
        "types": "./dist/lib/api/index.d.cts",
        "default": "./dist/lib/api/index.cjs"
      }
    },
    "./queue": {
      "import": {
        "types": "./dist/lib/queue/index.d.mts",
        "default": "./dist/lib/queue/index.mjs"
      },
      "require": {
        "types": "./dist/lib/queue/index.d.cts",
        "default": "./dist/lib/queue/index.cjs"
      }
    },
    "./pubsub": {
      "import": {
        "types": "./dist/lib/pubsub/index.d.mts",
        "default": "./dist/lib/pubsub/index.mjs"
      },
      "require": {
        "types": "./dist/lib/pubsub/index.d.cts",
        "default": "./dist/lib/pubsub/index.cjs"
      }
    },
    "./cron": {
      "import": {
        "types": "./dist/lib/cron/index.d.mts",
        "default": "./dist/lib/cron/index.mjs"
      },
      "require": {
        "types": "./dist/lib/cron/index.d.cts",
        "default": "./dist/lib/cron/index.cjs"
      }
    },
    "./logging": {
      "import": {
        "types": "./dist/lib/logging/index.d.mts",
        "default": "./dist/lib/logging/index.mjs"
      },
      "require": {
        "types": "./dist/lib/logging/index.d.cts",
        "default": "./dist/lib/logging/index.cjs"
      }
    },
    "./prompts": {
      "import": {
        "types": "./dist/lib/prompts/index.d.mts",
        "default": "./dist/lib/prompts/index.mjs"
      },
      "require": {
        "types": "./dist/lib/prompts/index.d.cts",
        "default": "./dist/lib/prompts/index.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/lib/cli/index.d.mts",
        "default": "./dist/lib/cli/index.mjs"
      },
      "require": {
        "types": "./dist/lib/cli/index.d.cts",
        "default": "./dist/lib/cli/index.cjs"
      }
    },
    "./workflow": {
      "import": {
        "types": "./dist/lib/workflow/index.d.mts",
        "default": "./dist/lib/workflow/index.mjs"
      },
      "require": {
        "types": "./dist/lib/workflow/index.d.cts",
        "default": "./dist/lib/workflow/index.cjs"
      }
    },
    "./orm": {
      "import": {
        "types": "./dist/lib/orm/index.d.mts",
        "default": "./dist/lib/orm/index.mjs"
      },
      "require": {
        "types": "./dist/lib/orm/index.d.cts",
        "default": "./dist/lib/orm/index.cjs"
      }
    },
    "./extra": {
      "import": {
        "types": "./dist/lib/extra/index.d.mts",
        "default": "./dist/lib/extra/index.mjs"
      },
      "require": {
        "types": "./dist/lib/extra/index.d.cts",
        "default": "./dist/lib/extra/index.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/lib/schema/index.d.mts",
        "default": "./dist/lib/schema/index.mjs"
      },
      "require": {
        "types": "./dist/lib/schema/index.d.cts",
        "default": "./dist/lib/schema/index.cjs"
      }
    }
  },
  "workspaces": [
    "apps/*"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "biome check --write . && tsc --noEmit",
    "test": "bun test",
    "docs:dev": "bun run --filter @semola/docs dev",
    "docs:build": "bun run --filter @semola/docs build",
    "docs:start": "bun run --filter @semola/docs start",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "bun",
    "typescript",
    "type-safe",
    "zero-dependency",
    "openapi",
    "rest-api",
    "api-framework",
    "orm",
    "redis",
    "queue",
    "pubsub",
    "caching",
    "workflow",
    "durable-workflow",
    "cron",
    "scheduler",
    "i18n",
    "internationalization",
    "authorization",
    "policy",
    "otel",
    "observability",
    "cli",
    "standard-schema",
    "backend",
    "middleware",
    "validation"
  ],
  "author": "Leonardo Dipace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonardodipace/semola.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@standard-schema/spec": "^1.1.0",
    "@standard-schema/utils": "^0.3.0",
    "@types/bun": "latest",
    "@valibot/to-json-schema": "^1.7.1",
    "arktype": "^2.2.1",
    "bun-types": "1.4.3",
    "openapi-types": "^12.1.3",
    "tsdown": "^0.22.14",
    "typescript": "^7",
    "valibot": "^1.4.1",
    "zod": "^4.3.6"
  }
}
