{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "semola",
  "main": "apps/docs/.open-next/worker.js",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "apps/docs/.open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "previews": {},
  "preview_urls": true
}
