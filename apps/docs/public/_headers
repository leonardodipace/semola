# Fingerprinted Next build assets — never revalidate until the URL changes.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# OpenNext SSG incremental cache (worker-only via ASSETS). Build id is in the path.
/cdn-cgi/_next_cache/*
  Cache-Control: public, max-age=31536000, immutable

# Public brand asset — updates only on deploy.
/logo.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
